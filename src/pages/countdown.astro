---
import CountdownTimer from "../components/CountdownTimer.astro";
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="一個簡單好用的倒數計時器，可倒數到指定時間或倒數一段時間。" />
    <title>倒數計時器</title>
  </head>
  <body>
    <main>
      <CountdownTimer title="倒數計時器" />
    </main>

    <style is:global>
      :root {
        color-scheme: dark;
      }
      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #0f172a;
      }
      main {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }
    </style>
  </body>
</html>
