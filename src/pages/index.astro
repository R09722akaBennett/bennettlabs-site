---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import {
  profile,
  focusAreas,
  metrics,
  projects,
  capabilities,
  process,
  experience,
  stackGroups,
  faqs,
} from "@data/profile";
---

<Layout
  title="AI Engineer"
  description={profile.tagline}
>
  <Container>
    <!-- Hero -->
    <section class="animate mb-16">
      <hr class="gradient-divider mb-8" />
      <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="section-title mb-3">{profile.role} / {profile.location}</p>
          <h1 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl" style="color: var(--color-text); line-height: 1.1;">
            {profile.tagline}
          </h1>
          <p class="mb-6 text-base leading-relaxed" style="color: var(--color-text-muted); max-width: 540px;">
            {profile.intro}
          </p>
          <div class="flex flex-wrap gap-2">
            {focusAreas.map((area) => (
              <span class="focus-pill">
                <span style="color: var(--color-accent);">&#9656;</span>
                {area}
              </span>
            ))}
          </div>
        </div>

        <!-- Profile panel -->
        <div class="card p-6 flex flex-col gap-5 self-start">
          <div>
            <p class="section-title mb-2">Profile</p>
            <p class="text-lg font-semibold" style="color: var(--color-text);">{profile.name}</p>
            <p class="meta">{profile.availability}</p>
          </div>
          <div class="flex flex-col gap-2">
            <a href={`mailto:${profile.email}`} class="social-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              {profile.email}
            </a>
            <a href={profile.links.github} target="_blank" rel="noopener" class="social-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              GitHub
            </a>
            <a href={profile.links.linkedin} target="_blank" rel="noopener" class="social-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Metrics snapshot -->
    <section class="animate mb-16">
      <p class="section-title mb-4">Professional snapshot</p>
      <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        {metrics.map((m) => (
          <div class="card card-accent-cyan p-4">
            <p class="meta mb-1">{m.label}</p>
            <p class="text-base font-semibold" style="color: var(--color-text);">{m.value}</p>
            <p class="mt-1 text-xs leading-relaxed" style="color: var(--color-text-muted);">{m.note}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="animate mb-16">
      <hr class="gradient-divider mb-6" />
      <p class="section-title mb-4">Featured projects</p>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((p, i) => (
          <a href={p.href} target="_blank" rel="noopener" class:list={[
            "card p-5 flex flex-col gap-3 no-underline group",
            i % 3 === 0 ? "card-accent-cyan" : i % 3 === 1 ? "card-accent-warm" : "card-accent-purple"
          ]}>
            <div>
              <h3 class="text-sm font-semibold group-hover:underline" style="color: var(--color-text);">{p.title}</h3>
              <p class="mt-1.5 text-xs leading-relaxed" style="color: var(--color-text-muted);">{p.summary}</p>
            </div>
            <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">
              <span class="font-semibold" style="color: var(--color-text);">Impact:</span> {p.impact}
            </p>
            <div class="mt-auto flex flex-wrap gap-1.5">
              {p.stack.map((s) => (
                <span class="tag tag-tech">{s}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Capabilities -->
    <section id="capabilities" class="animate mb-16">
      <hr class="gradient-divider mb-6" />
      <p class="section-title mb-4">Core capabilities</p>
      <div class="grid gap-4 md:grid-cols-2">
        {capabilities.map((c, i) => (
          <div class:list={[
            "card p-5",
            i % 2 === 0 ? "card-accent-cyan" : "card-accent-warm"
          ]}>
            <h3 class="text-sm font-semibold mb-2" style="color: var(--color-text);">{c.title}</h3>
            <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">{c.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Process -->
    <section class="animate mb-16">
      <p class="section-title mb-4">How I deliver</p>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {process.map((step, i) => (
          <div class="card card-accent-green p-5">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full text-xs font-bold" style={`background-color: color-mix(in srgb, var(--color-green) 15%, transparent); color: var(--color-green);`}>
              {i + 1}
            </span>
            <h3 class="mt-2 text-sm font-semibold" style="color: var(--color-text);">{step.title}</h3>
            <p class="mt-1.5 text-xs leading-relaxed" style="color: var(--color-text-muted);">{step.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Experience + Stack -->
    <section id="experience" class="animate mb-16">
      <hr class="gradient-divider mb-6" />
      <div class="grid gap-8 lg:grid-cols-[1.3fr_1fr]">
        <div>
          <p class="section-title mb-4">Experience</p>
          <div class="flex flex-col gap-4">
            {experience.map((e, i) => (
              <div class:list={[
                "card p-5",
                i === 0 ? "card-accent-cyan" : "card-accent-warm"
              ]}>
                <div class="flex items-center gap-2 mb-2">
                  <span class="tag tag-tech">{e.period}</span>
                  <h3 class="text-sm font-semibold" style="color: var(--color-text);">{e.title}</h3>
                </div>
                <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">{e.detail}</p>
              </div>
            ))}
          </div>
        </div>
        <div>
          <p class="section-title mb-4">Toolkit</p>
          <div class="flex flex-col gap-3">
            {stackGroups.map((group) => (
              <div class="card p-4">
                <p class="meta mb-2 font-semibold">{group.title}</p>
                <div class="flex flex-wrap gap-1.5">
                  {group.items.map((item) => (
                    <span class="tag tag-tech">{item}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="animate mb-16">
      <p class="section-title mb-4">FAQ</p>
      <div class="grid gap-4 md:grid-cols-3">
        {faqs.map((faq) => (
          <div class="card card-accent-warm p-5">
            <h3 class="text-sm font-semibold mb-2" style="color: var(--color-text);">{faq.question}</h3>
            <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="animate mb-8">
      <div class="card p-8 text-center" style="background: linear-gradient(135deg, var(--color-surface-muted), var(--color-surface-raised)); border-color: var(--color-border);">
        <p class="section-title mb-3">Get in touch</p>
        <h2 class="text-xl font-bold mb-2" style="color: var(--color-text);">Let's build something reliable</h2>
        <p class="text-sm mb-5 mx-auto" style="color: var(--color-text-muted); max-width: 420px;">
          {profile.availability}
        </p>
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex items-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold text-white no-underline transition-all duration-200 hover:opacity-90"
          style="background-color: var(--color-accent);"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          {profile.email}
        </a>
      </div>
    </section>
  </Container>
</Layout>

<style>
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .social-link:hover {
    color: var(--color-accent);
  }
</style>
